PORT=4000
HOST=127.0.0.1
# Leave DATABASE_URL empty for local SQLite. Set it on the hosted backend to use Postgres.
DATABASE_URL=
# Set DATABASE_SSL=disable only for a trusted local Postgres server.
DATABASE_SSL=
# Comma-separated browser origins allowed to call the hosted API.
ALLOWED_ORIGINS=
# Gmail notifications (use a Google App Password, not your normal password)
GMAIL_USER=
GMAIL_APP_PASSWORD=
GMAIL_SMTP_HOST=smtp.gmail.com
GMAIL_SMTP_PORT=587
# Optional Resend fallback if you own and verify a sending domain
RESEND_API_KEY=
EMAIL_FROM=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_API_VERSION=v23.0
WHATSAPP_TEMPLATE_NAME=
WHATSAPP_TEMPLATE_LANGUAGE=en_US
